*.db
*.sqlite
*.sqlite3

# Specific generated databases in data folder
data/*.db
data/test_*.db

# Helper to ensure data directories exist but contents are valid to ignore if they are just generated files
# (Uncomment if you want to ignore all contents of data/processed)
# data/processed/*
# !data/processed/.gitkeep

